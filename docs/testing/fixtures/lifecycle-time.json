{
  "fixtureVersion": 1,
  "purpose": "Lifecycle, clock, restart, and gap correctness",
  "cases": [
    {
      "id": "LIFE-001",
      "scenario": "Lock and unlock",
      "events": [
        {"t":"10:00:00","type":"foreground","target":"AppA"},
        {"t":"10:30:00","type":"lock"},
        {"t":"11:00:00","type":"unlock"},
        {"t":"11:05:00","type":"foreground","target":"AppB"}
      ],
      "expected": {"AppAForegroundMs":1800000,"lockedPeriodCountsAsAppUsage":false,"postUnlockObservationRequired":true},
      "userFriction":"A locked period must never inflate screen time or create a phantom app session."
    },
    {
      "id":"LIFE-002",
      "scenario":"Sleep and resume",
      "events":[
        {"t":"12:00:00","type":"foreground","target":"AppA"},
        {"t":"12:20:00","type":"suspend"},
        {"t":"13:15:00","type":"resume"},
        {"t":"13:16:00","type":"foreground","target":"AppB"}
      ],
      "expected":{"suspendedPeriodNotAttributedToApp":true,"resumeCreatesBoundary":true},
      "userFriction":"The timeline should explain a long blank period instead of implying the app ran unused for 55 minutes."
    },
    {
      "id":"LIFE-003",
      "scenario":"Tracker crash and restart",
      "events":[
        {"t":"14:00:00","type":"foreground","target":"AppA"},
        {"t":"14:32:07","type":"trackerCrash"},
        {"t":"14:33:01","type":"trackerRestart"},
        {"t":"14:33:05","type":"foreground","target":"AppB"}
      ],
      "expected":{"gap":["14:32:07","14:33:01"],"usageFabricatedAcrossGap":false,"newRuntimeSession":true},
      "userFriction":"Users should see an explicit tracking gap and not be blamed for missing history."
    },
    {
      "id":"LIFE-004",
      "scenario":"Storage unavailable with bounded buffer",
      "events":[
        {"t":"15:00:00","type":"foreground","target":"AppA"},
        {"t":"15:10:00","type":"storageUnavailable"},
        {"t":"15:10:30","type":"foreground","target":"AppB"},
        {"t":"15:11:00","type":"storageRecovered"}
      ],
      "expected":{"inMemoryBufferBounded":true,"unrecoverableOverflowBecomesGap":true,"recoveredDataCommittedWithoutDuplication":true},
      "userFriction":"A rare storage problem should be visible as a data-quality issue, not silently converted into inaccurate totals."
    },
    {
      "id":"LIFE-005",
      "scenario":"Wall clock moves backward",
      "events":[
        {"t":"16:00:00","type":"foreground","target":"AppA","mono":1000},
        {"t":"16:20:00","type":"clockSetBackward","wallClock":"15:50:00","mono":1210000},
        {"t":"16:21:00","type":"foreground","target":"AppB","mono":1270000}
      ],
      "expected":{"negativeDuration":false,"durationUsesMonotonic":true,"clockDiscontinuityRecorded":true},
      "userFriction":"A clock correction must not create negative usage, duplicated hours, or impossible timeline ordering without a visible caveat."
    },
    {
      "id":"LIFE-006",
      "scenario":"Timezone change",
      "events":[
        {"t":"2026-09-02T09:00:00Z","type":"foreground","target":"AppA"},
        {"t":"2026-09-02T09:30:00Z","type":"timezoneChange","from":"Asia/Kolkata","to":"Europe/Berlin"},
        {"t":"2026-09-02T10:00:00Z","type":"foreground","target":"AppB"}
      ],
      "expected":{"durationsContinuous":true,"historicalInstantsRemainUTC":true,"localDayProjectionChangesOnlyInPresentation":true},
      "userFriction":"Changing timezone should not rewrite old durations or cause apparent duplicated activity."
    },
    {
      "id":"LIFE-007",
      "scenario":"Sign out and sign in",
      "events":[
        {"t":"17:00:00","type":"foreground","target":"AppA"},
        {"t":"17:30:00","type":"logoff"},
        {"t":"18:15:00","type":"logon"},
        {"t":"18:16:00","type":"foreground","target":"AppB"}
      ],
      "expected":{"crossUserAttribution":false,"newInteractiveSession":true,"preLogoffIntervalClosed":true},
      "userFriction":"Usage must not bleed between Windows user sessions."
    },
    {
      "id":"LIFE-008",
      "scenario":"Tracker starts while app is already foreground",
      "events":[
        {"t":"08:59:58","type":"appState","target":"AppA"},
        {"t":"09:00:00","type":"trackerStart"},
        {"t":"09:00:02","type":"reconcileForeground","target":"AppA"}
      ],
      "expected":{"trackingBeginsAtEvidenceBoundary":"09:00:02","preStartUsageNotInvented":true},
      "userFriction":"Opening the app after startup should not make the product claim it knows the prior two seconds."
    }
  ]
}
