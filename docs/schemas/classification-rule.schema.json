{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pcusage://schemas/classification-rule.v1.json",
  "title": "Classification Rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ruleId", "targetType", "targetKey", "classification", "source", "createdAtUtc", "effectiveFromUtc"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ruleId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "targetType": { "enum": ["Application", "Domain", "Executable", "Package", "ProcessFamily"] },
    "targetKey": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categoryKey", "productivityValue"],
      "properties": {
        "categoryKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "productivityValue": { "enum": ["Productive", "Leisure", "Neutral", "Unclassified"] }
      }
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "source": { "enum": ["System", "UserOverride", "Imported", "Model"] },
    "priority": { "type": "integer", "minimum": 0, "default": 0 },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "effectiveFromUtc": { "type": "string", "format": "date-time" },
    "effectiveToUtc": { "type": ["string", "null"], "format": "date-time" }
  }
}
